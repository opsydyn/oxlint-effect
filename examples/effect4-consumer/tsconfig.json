{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "types": ["bun-types", "node"],
    "target": "ES2022",
    "skipLibCheck": true
  },
  "include": [
    "src",
    "*.config.ts"
  ]
}
