      }
    }
  },
  {
    "rule": "no-catchall-generic-rethrow",
    "version": 3,
    "classification": "unchanged",
    "variants": [
      "data-first expression",
      "piped block return"
    ],
    "bad": [
      "src/recovery-runtime/rethrow.ts"
    ],
    "good": [
      "src/recovery-runtime/valid.ts"
    ],
    "expectedByFile": {
      "src/recovery-runtime/rethrow.ts": {
        "linteffect/no-catchall-generic-rethrow": 2
      }
    },
    "runtime": "src/recovery-runtime/contracts.ts"
  },
  {
    "rule": "no-early-catchall-null",
    "version": 3,
    "classification": "unchanged",
    "variants": [
      "null expression",
      "undefined block",
      "named fallback"
    ],
    "bad": [
      "src/recovery-runtime/fallback.ts"
    ],
    "good": [
      "src/recovery-runtime/valid.ts",
      "src/recovery-runtime/main.ts"
    ],
    "expectedByFile": {
      "src/recovery-runtime/fallback.ts": {
        "linteffect/no-early-catchall-null": 3
      }
    },
    "runtime": "src/recovery-runtime/contracts.ts"
  },
  {
    "rule": "no-run-effect-outside-boundary",
    "version": 3,
    "classification": "adapted",
    "variants": [
      "six ordinary executions",
      "boundary controls"
    ],
    "bad": [
      "src/recovery-runtime/runners.ts"
    ],
    "good": [
      "src/recovery-runtime/valid.ts",
      "src/recovery-runtime/main.ts"
    ],
    "expectedByFile": {
      "src/recovery-runtime/runners.ts": {
        "linteffect/no-run-effect-outside-boundary": 6
      }
    }
